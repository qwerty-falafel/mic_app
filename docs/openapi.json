{
  "openapi": "3.0.3",
  "info": {
    "title": "MIC Product Development API",
    "version": "0.14.0",
    "description": "Local AI-guided Product development control plane with Product direction, Brief proposals, Scrum delivery, durable workflows, immutable artifacts and explicit integration."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:3100"
    }
  ],
  "components": {
    "parameters": {
      "id": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "key": {
        "name": "Idempotency-Key",
        "in": "header",
        "schema": {
          "type": "string"
        }
      }
    },
    "schemas": {
      "Project": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          }
        }
      },
      "Repository": {
        "type": "object",
        "required": [
          "path"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "baseBranch": {
            "type": "string",
            "default": "main"
          }
        }
      },
      "WorkItem": {
        "type": "object",
        "required": [
          "projectId",
          "title",
          "intent"
        ],
        "properties": {
          "projectId": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "intent": {
            "type": "string"
          },
          "priority": {
            "type": "integer"
          }
        }
      },
      "Approval": {
        "type": "object",
        "required": [
          "artifactHash",
          "approver"
        ],
        "properties": {
          "artifactHash": {
            "type": "string"
          },
          "approver": {
            "type": "string",
            "default": "Michael"
          }
        }
      },
      "PlanningFeedback": {
        "type": "object",
        "required": [
          "artifactHash",
          "feedback",
          "actor"
        ],
        "properties": {
          "artifactHash": {
            "type": "string"
          },
          "feedback": {
            "type": "string"
          },
          "actor": {
            "type": "string",
            "default": "Michael"
          }
        }
      },
      "BuildTarget": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "type",
              "intent"
            ],
            "properties": {
              "type": {
                "const": "direct"
              },
              "intent": {
                "type": "string"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "type",
              "path"
            ],
            "properties": {
              "type": {
                "const": "spec"
              },
              "path": {
                "type": "string"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "type",
              "specFolder",
              "storyId"
            ],
            "properties": {
              "type": {
                "const": "story"
              },
              "specFolder": {
                "type": "string"
              },
              "storyId": {
                "type": "string"
              }
            }
          }
        ]
      },
      "Answer": {
        "type": "object",
        "required": [
          "answer",
          "actor"
        ],
        "properties": {
          "answer": {
            "type": "string"
          },
          "actor": {
            "type": "string",
            "default": "Michael"
          }
        }
      },
      "Object": {
        "type": "object",
        "additionalProperties": true
      },
      "Workstream": {
        "type": "object",
        "required": [
          "projectId",
          "repositoryId",
          "title",
          "intent",
          "path"
        ],
        "properties": {
          "projectId": {
            "type": "string"
          },
          "repositoryId": {
            "type": "string"
          },
          "legacyWorkItemId": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "intent": {
            "type": "string"
          },
          "path": {
            "type": "string",
            "enum": [
              "undecided",
              "direct",
              "spec-epic",
              "project",
              "specialist"
            ]
          }
        }
      },
      "WorkflowStart": {
        "type": "object",
        "required": [
          "workstreamId",
          "skill",
          "prompt"
        ],
        "properties": {
          "workstreamId": {
            "type": "string"
          },
          "skill": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "args": {
            "type": "object"
          },
          "prompt": {
            "type": "string"
          }
        }
      },
      "WorkflowResponse": {
        "type": "object",
        "required": [
          "content"
        ],
        "properties": {
          "content": {
            "type": "string"
          },
          "actor": {
            "type": "string",
            "default": "Michael"
          }
        }
      },
      "Review": {
        "type": "object",
        "required": [
          "kind",
          "actor"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "accepted",
              "rejected",
              "feedback",
              "override"
            ]
          },
          "feedback": {
            "type": "string"
          },
          "actor": {
            "type": "string",
            "default": "Michael"
          }
        }
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [

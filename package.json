{
  "name": "mic-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "phase0": "tsx scripts/phase0-validate.ts",
    "predev": "npm run web:build",
    "dev": "tsx scripts/dev.ts",
    "dev:api": "tsx watch src/main.ts",
    "dev:web": "vite --config frontend/vite.config.ts",
    "db:start": "tsx scripts/dev-postgres.ts",
    "web:build": "vite build --config frontend/vite.config.ts",
    "web:check": "tsc --noEmit -p frontend/tsconfig.json",
    "start": "node dist/src/main.js",
    "serve": "node dist/scripts/serve.js",
    "production:build": "npm run web:build && npm run build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "test": "vitest run",
    "test:integration": "vitest run test/integration",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "10.1.3",
    "@fastify/swagger": "9.8.1",
    "@fastify/swagger-ui": "6.1.1",
    "drizzle-orm": "0.45.2",
    "fastify": "5.12.3",
    "jose": "^6.2.12",
    "pg": "8.23.0",
    "pg-boss": "12.30.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "yaml": "2.9.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "22.18.0",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.0",
    "drizzle-kit": "0.31.10",
    "embedded-postgres": "18.4.0-beta.17",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  }
}

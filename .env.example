# MIC binds locally even when Cloudflare publishes it remotely.
HOST=127.0.0.1
PORT=3100
MIC_DB_PORT=54329

# Production remote boundary. Replace all placeholders before starting.
MIC_DEPLOYMENT_MODE=remote
MIC_PUBLIC_ORIGIN=https://mic.aidevtools.co.uk
MIC_ACCESS_TEAM_DOMAIN=https://YOUR-TEAM.cloudflareaccess.com
MIC_ACCESS_AUDIENCE=YOUR-CLOUDFLARE-ACCESS-APPLICATION-AUD
MIC_ACCESS_EMAIL=YOUR-EXACT-ACCESS-EMAIL

# MIC always uses the local llama.cpp router and GPT-OSS 120B by default.
MIC_MODEL_ROUTER_URL=http://127.0.0.1:10000/v1/chat/completions
MIC_MODEL=llama.cpp/gpt-oss-120b-F16
